# Используем официальный образ Node.js для фронтенда
FROM node:18.18.2

# Устанавливаем рабочую директорию
WORKDIR /app

# Устанавливаем npm версии 6.14.18
RUN npm install -g npm@6.14.18

# Копируем package.json и устанавливаем зависимости
COPY package*.json ./
RUN npm install

# Копируем все файлы в контейнер
COPY . .

# Собираем проект для продакшн
RUN npm run build

# Открываем порт 3000 для доступа
EXPOSE 3000

# Команда для запуска приложения
CMD ["npm", "start"]