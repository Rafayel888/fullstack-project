{
  "compilerOptions": {
    "module": "NodeNext", // Используем NodeNext для модуля
    "moduleResolution": "NodeNext", // Разрешение модулей для Node.js
    "target": "ES2022", // Целевая версия JavaScript
    "esModuleInterop": true, // Поддержка совместимости с CommonJS
    "skipLibCheck": true, // Пропуск проверки библиотек
    "strict": true, // Строгая проверка типов
    "resolveJsonModule": true, // Поддержка импорта JSON
    "allowJs": true // Разрешение использования .js файлов
  },
  "include": ["src/**/*"]
}
